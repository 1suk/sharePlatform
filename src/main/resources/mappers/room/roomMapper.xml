<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.shareCart.project.domain.room.model.mapper.RoomMapper">
    <insert id="insertRoom"
            parameterType="com.shareCart.project.domain.room.model.vo.RoomVO"
            useGeneratedKeys="true"
            keyProperty="id"
    >
    INSERT INTO `rooms`(
        town_id,
        host_id,
        market_name,
        meet_place,
        meet_at
    )VALUES(
        #{townId},
        #{hostId},
        #{marketName},
        #{meetPlace},
        #{meetAt}
    )
    </insert>

    <insert id="insertRoomItems">
        INSERT INTO `room_items`(
            room_id,
            item_name
        )VALUES
        <foreach collection="items" item="item" separator=",">
        (
            #{roomId},
            #{item.itemName}
        )
        </foreach>
    </insert>
</mapper>