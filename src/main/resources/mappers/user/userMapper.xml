<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.shareCart.project.mapper.userMapper">

    <insert id="insertUser"
            parameterType="com.shareCart.project.vo.userVO"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO `users` (
            town_id,
            email,
            name,
            password,
            phone
        ) VALUES (
            #{townId},
            #{email},
            #{name},
            #{password},
            #{phone}
        )
    </insert>
</mapper>